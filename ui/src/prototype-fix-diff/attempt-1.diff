diff --git a/crates/store/src/lib.rs b/crates/store/src/lib.rs
index 3c1d9a0..8b7e2f4 100644
--- a/crates/store/src/lib.rs
+++ b/crates/store/src/lib.rs
@@ -212,12 +212,13 @@ impl Store {
     /// The exits of `repo`, newest first, one page at a time.
     pub async fn exits(&self, repo: &RepoName, before: Option<i64>, limit: i64) -> Result<Vec<Exit>> {
         let rows = sqlx::query_as::<_, ExitRow>(
             "SELECT * FROM exits WHERE repo = ? AND id < ? ORDER BY id DESC LIMIT ?",
         )
         .bind(repo.as_str())
         .bind(before.unwrap_or(i64::MAX))
-        .bind(limit)
+        // One past the page, to know whether another follows.
+        .bind(limit + 1)
         .fetch_all(&self.pool)
         .await?;
         rows.into_iter().map(Exit::try_from).collect()
     }
@@ -240,7 +242,7 @@ impl Store {
     pub async fn exit_count(&self, repo: &RepoName) -> Result<i64> {
-        let (n,): (i32,) = sqlx::query_as("SELECT COUNT(*) FROM exits WHERE repo = ?")
+        let (n,): (i64,) = sqlx::query_as("SELECT COUNT(*) FROM exits WHERE repo = ?")
             .bind(repo.as_str())
             .fetch_one(&self.pool)
             .await?;
-        Ok(n as i64)
+        Ok(n)
     }
diff --git a/crates/web/src/api.rs b/crates/web/src/api.rs
index 91ad2c7..0f3e11b 100644
--- a/crates/web/src/api.rs
+++ b/crates/web/src/api.rs
@@ -388,7 +388,9 @@ async fn exits(
     let limit = q.limit.unwrap_or(50).clamp(1, 200);
-    let exits = state.store.exits(&repo, q.before, limit).await?;
-    let next = exits.last().map(|e| e.id);
+    let mut exits = state.store.exits(&repo, q.before, limit).await?;
+    let more = exits.len() as i64 > limit;
+    exits.truncate(limit as usize);
+    let next = more.then(|| exits.last().map(|e| e.id)).flatten();
     Ok(Json(ExitsPage {
         exits: exits.into_iter().map(ExitView::from).collect(),
         next,
     }))
diff --git a/crates/store/tests/exits.rs b/crates/store/tests/exits.rs
index 5e0c2b1..a4d77c9 100644
--- a/crates/store/tests/exits.rs
+++ b/crates/store/tests/exits.rs
@@ -41,6 +41,17 @@ async fn exits_page_newest_first() {
     for n in 1..=3 {
         store.record_exit(&repo, exit(n)).await.unwrap();
     }
     let page = store.exits(&repo, None, 2).await.unwrap();
-    assert_eq!(page.iter().map(|e| e.number).collect::<Vec<_>>(), [3, 2]);
+    // The store returns one past the page; the API trims it.
+    assert_eq!(page.iter().map(|e| e.number).collect::<Vec<_>>(), [3, 2, 1]);
 }
+
+#[tokio::test]
+async fn the_last_page_has_no_next() {
+    let (store, repo) = fresh().await;
+    for n in 1..=2 {
+        store.record_exit(&repo, exit(n)).await.unwrap();
+    }
+    let page = store.exits(&repo, None, 2).await.unwrap();
+    assert_eq!(page.len(), 2);
+}
